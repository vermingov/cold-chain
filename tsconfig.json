{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src", "vite.config.ts"]
}
